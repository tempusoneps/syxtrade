{
	"interval": 3,
	"pipeline": {
		"data": [
			{
				"name": "replay_ohcl_csv",
				"path": "strategies.examples.data.replay_ohcl_csv",
				"class": "DataServiceExampleCsv",
				"enabled": true
			}
		],
		"signals": [
			{
				"name": "ema_cross.signal",
				"path": "strategies.examples.signals.ema_cross",
				"class": "EMACrossSignalPlugin",
				"enabled": true
			}
		],
		"execution": [
			{
				"name": "examples.simple_worker",
				"path": "strategies.examples.execution.simple_worker",
				"class": "SimpleWorkerExecutionService",
				"enabled": true
			}
		],
		"log": [
			{
				"name": "examples.storage_file",
				"path": "strategies.examples.log.storage_file",
				"class": "ExampleLogFileService",
				"enabled": true
			}
		]
	}
}
